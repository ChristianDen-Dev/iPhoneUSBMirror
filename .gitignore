# ---- Build outputs ----
build/

# ---- Secrets (never commit) ----
.env
*.env
secrets*

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/

# ---- Receiver local settings ----
receiver/settings.json

